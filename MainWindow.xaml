<Window x:Class="CybersecurityAwarenessBotPart2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="700" Width="950"
        Background="#5C061C" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="CYBERSECURITY AWARENESS" Foreground="#E5C158" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="Security Assistant" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,2,0,5"/>
            <TextBlock Text="Learn how to protect yourself in the digital world." Foreground="#D3D3D3" FontSize="14"/>
        </StackPanel>

        <!-- Quick Topics Section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="QUICK TOPICS" Foreground="#E5C158" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
            <WrapPanel>
                <Button Content="Password Safety" Tag="Password" Click="QuickTopic_Click" Background="#5C061C" Foreground="#E5C158" BorderBrush="#E5C158" BorderThickness="1" FontWeight="Bold" Width="130" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="Phishing" Tag="Phishing" Click="QuickTopic_Click" Background="#5C061C" Foreground="#E5C158" BorderBrush="#E5C158" BorderThickness="1" FontWeight="Bold" Width="100" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="Safe Browsing" Tag="Malware" Click="QuickTopic_Click" Background="#5C061C" Foreground="#E5C158" BorderBrush="#E5C158" BorderThickness="1" FontWeight="Bold" Width="120" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Content="Scams" Tag="Ransomware" Click="QuickTopic_Click" Background="#5C061C" Foreground="#E5C158" BorderBrush="#E5C158" BorderThickness="1" FontWeight="Bold" Width="90" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
            </WrapPanel>
        </StackPanel>

        <!-- Chat History Area -->
        <Border Grid.Row="2" Background="#3A020F" BorderBrush="#E5C158" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,5,0,10">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtChatHistory" Foreground="White" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas"/>
            </ScrollViewer>
        </Border>

        <!-- Input Area with Send & Clear Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtUserInput" Grid.Column="0" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="8,0"
                     KeyDown="TxtUserInput_KeyDown" Background="#4A0313" Foreground="White" BorderBrush="#E5C158"/>
            <Button x:Name="BtnSend" Grid.Column="1" Content="SEND" Click="BtnSend_Click" 
                    Background="#2A6F49" Foreground="White" FontWeight="Bold" Height="38" Margin="10,0,0,0" Cursor="Hand"/>
            <Button x:Name="BtnClear" Grid.Column="2" Content="CLEAR" Click="BtnClear_Click" 
                    Background="#5C061C" Foreground="#E5C158" BorderBrush="#E5C158" BorderThickness="1" FontWeight="Bold" Height="38" Margin="10,0,0,0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
    